{
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "postinstall": "turbo run install",
    "deploy": "turbo run deploy",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "dependencies": {
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "19.0.2",
    "prettier": "^3.3.3",
    "turbo": "latest",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.2.0"
}
