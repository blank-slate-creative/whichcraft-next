{
  "expo": {
    "name": "WhichCraft",
    "slug": "whichcraft",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "whichcraft",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "usesAppleSignIn": true,
      "supportsTablet": true,
      "bundleIdentifier": "com.ericcecchi.whichcraft",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon.png"
      },
      "associatedDomains": [
        "webcredentials:whichcraft.ericcecchi.com",
        "applinks:whichcraft.ericcecchi.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.ericcecchi.whichcraft"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0A"
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "59889b6f-78e7-42d1-ae40-66ba590b90f3"
      }
    }
  }
}
