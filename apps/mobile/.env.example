# WhichCraft Mobile App - Environment Variables
# Copy this file to .env and replace the placeholder values with your actual credentials

# Supabase Configuration
# Your Supabase project URL (found in your Supabase dashboard)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anon/public key (found in your Supabase dashboard under API settings)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# API Configuration
# URL for the WhichCraft API (e.g., your Flask backend)
EXPO_PUBLIC_API_URL=https://api.whichcraft.example.com

# Optional: Analytics and Monitoring
# EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn

# Optional: Feature Flags
# EXPO_PUBLIC_ENABLE_CAMERA_FEATURE=true
# EXPO_PUBLIC_ENABLE_OFFLINE_MODE=true

# Optional: App Configuration
# EXPO_PUBLIC_APP_VERSION=1.0.0
# EXPO_PUBLIC_MAX_UPLOAD_SIZE=10485760 

EXPO_USE_METRO_WORKSPACE_ROOT=true