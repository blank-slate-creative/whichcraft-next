{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "mise install && uv venv --python $(mise which python) && uv pip install -r requirements.txt",
    "dev": "uv run -m uvicorn app.main:app --reload",
    "deploy": "./deploy-api.sh",
    "build": "docker build -t api .",
    "start": "docker run -p 8080:8080 api"
  }
}
